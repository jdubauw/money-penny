APP_USERNAME=admin
# Use long random passwords. POSTGRES_PASSWORD must be URL-safe (hex is suitable).
APP_PASSWORD=
POSTGRES_PASSWORD=
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SESSION_SECRET=
APP_ORIGIN=https://spending.example.com
COOKIE_SECURE=true
AI_PROVIDER=none
# Ollama on the Coolify host, or change to your LAN host / shared Docker service.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
# API key is server-side only. Choose a model available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
